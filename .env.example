# Copy this file to ".env" and fill in your key to enable the AI chat.
# The chat uses GLM 5.2 via NVIDIA's OpenAI-compatible NIM API.
# Get a key at https://build.nvidia.com (open the GLM 5.2 model -> "Get API Key").

NVIDIA_API_KEY=nvapi-...

# Optional: override the model. Default is z-ai/glm-5.2
# CHAT_MODEL=z-ai/glm-5.2
